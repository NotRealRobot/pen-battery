<?xml version="1.0" encoding="utf-8"?>
<!-- 只有描边的圆角 shape：用作胶囊的 foreground（画在最上层）与 background（提供 28dp 圆角轮廓）
     ⚠️ 故意**不放 solid** —— 若有实心填充会把底下的模糊图盖掉 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="@color/nav_glass_border" />
</shape>
