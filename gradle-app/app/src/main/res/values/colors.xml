<?xml version="1.0" encoding="utf-8"?>
<!--
  MD3 品牌色板 · 方案 B「青柠纸感」(2026-11-10 用户选定，接替方案 A「青柠气泡」)。
  ★ 保留青柠作为强调色，但大面积中性色收向暖纸白（只留极淡的黄绿倾向），
    绿集中在 primary / 容器 / 选中胶囊上 —— 从"整屏发绿"变成"纸上的青柠"。
  ★ 中性色层级仍按 M3 的 tone 顺序（surface 98 / containerLow 96 / container 94 /
    containerHigh 92 / containerHighest 90），只改色相与彩度。
  ★ 对比度实测：正文/卡片 15.20、链接/卡片 5.36、描边/卡片 3.92、
    onPrimary 5.95、onSecondary 5.22，均过 WCAG AA。
-->
<resources>
    <!-- primary：青柠绿（深一档 ⇒ 链接在卡片上的对比度留出余量） -->
    <color name="md_theme_primary">#FF456F00</color>
    <color name="md_theme_onPrimary">#FFFFFFFF</color>
    <color name="md_theme_primaryContainer">#FFD4EF92</color>
    <color name="md_theme_onPrimaryContainer">#FF1A2A00</color>

    <!-- secondary：嫩橄榄（secondaryContainer 同时是底栏选中胶囊的底色） -->
    <color name="md_theme_secondary">#FF647150</color>
    <color name="md_theme_onSecondary">#FFFFFFFF</color>
    <color name="md_theme_secondaryContainer">#FFDEE8C4</color>
    <color name="md_theme_onSecondaryContainer">#FF202B0A</color>

    <!-- tertiary：青（与图标/笔的青色呼应） -->
    <color name="md_theme_tertiary">#FF0E7A79</color>
    <color name="md_theme_onTertiary">#FFFFFFFF</color>
    <color name="md_theme_tertiaryContainer">#FFB5EDEB</color>
    <color name="md_theme_onTertiaryContainer">#FF00201F</color>

    <!-- error：M3 标准红 -->
    <color name="md_theme_error">#FFBA1A1A</color>
    <color name="md_theme_onError">#FFFFFFFF</color>
    <color name="md_theme_errorContainer">#FFFFDAD6</color>
    <color name="md_theme_onErrorContainer">#FF410002</color>

    <!-- 中性色：暖纸白，黄绿倾向只保留一点，不再给整屏染绿 -->
    <color name="md_theme_surface">#FFFAFBF6</color>
    <color name="md_theme_surfaceDim">#FFDADCCF</color>
    <color name="md_theme_surfaceBright">#FFFAFBF6</color>
    <color name="md_theme_onSurface">#FF1B1E17</color>
    <color name="md_theme_surfaceVariant">#FFDFE3D4</color>
    <color name="md_theme_onSurfaceVariant">#FF4A4E42</color>
    <color name="md_theme_surfaceContainerLowest">#FFFFFFFF</color>
    <color name="md_theme_surfaceContainerLow">#FFF2F4EB</color>
    <color name="md_theme_surfaceContainer">#FFEBEEE2</color>
    <color name="md_theme_surfaceContainerHigh">#FFE4E8D9</color>
    <color name="md_theme_surfaceContainerHighest">#FFDDE2CF</color>
    <color name="md_theme_outline">#FF767B6C</color>
    <color name="md_theme_outlineVariant">#FFC6CAB9</color>
    <color name="md_theme_surfaceInverse">#FF2F332A</color>
    <color name="md_theme_onSurfaceInverse">#FFF0F2E6</color>
    <color name="md_theme_primaryInverse">#FFB7E86B</color>

    <!-- 悬浮底栏：半透明（首次绘制 / 模糊兜底时用；83% ⇒ 仍能透出一点内容） -->
    <color name="nav_floating_bg">#CCEEF2E2</color>

    <!-- 毛玻璃蒙版：盖在模糊底图之上，alpha 越低越通透。
         6% ⇒ 几乎只剩"提亮一层"，通透度交给模糊本身去做。 -->
    <color name="nav_glass_scrim">#0FF7F9EF</color>

    <!-- 胶囊描边：底色是纯色时靠它勾出轮廓（毛玻璃观感的关键） -->
    <color name="nav_glass_border">#21000000</color>

    <!-- 电量渐变（底板用）：5 档标定，按 0/15/35/60/100 分段线性插值。
         设计意图：高电量是带一点黄的青柠绿（有生气但不刺眼），
         只有真的接近见底才逐步走向鲜艳的红 —— 警示色要"晚到"才有效。 -->
    <color name="battery_crit">#FFCC4F44</color>
    <color name="battery_low">#FFDB8C46</color>
    <color name="battery_fair">#FFD0B84A</color>
    <color name="battery_ok">#FF8BBF45</color>
    <color name="battery_full">#FF5CA316</color>

    <!-- 下拉刷新时的页面蒙版（MD3 对话框同款 32% 黑） -->
    <color name="refresh_scrim">#52000000</color>

    <!-- 卡片涟漪：低透明度墨色（用户要求：无可点按键的面板也要有涟漪，减弱变色但保留动画） -->
    <color name="card_ripple">#1A000000</color>
</resources>
